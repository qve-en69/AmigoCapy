<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <AssemblyName>AmigoClick</AssemblyName>
    <RootNamespace>AmigoClick</RootNamespace>
    <ApplicationIcon>AmigoClick.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>AmigoClick</Product>
    <AssemblyTitle>AmigoClick</AssemblyTitle>
    <Description>Автокликер</Description>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="AmigoClick.ico" />
  </ItemGroup>

</Project>
