<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <AssemblyName>AmigoCapy</AssemblyName>
    <RootNamespace>AmigoCapy</RootNamespace>
    <ApplicationIcon>AmigoCapy.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.6.0</Version>
    <Product>AmigoCapy</Product>
    <AssemblyTitle>AmigoCapy</AssemblyTitle>
    <Description>Автокликер</Description>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="AmigoCapy.ico" />
    <Resource Include="Assets\**\*.png" />
  </ItemGroup>

</Project>
