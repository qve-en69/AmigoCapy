<UserControl x:Class="AmigoCapy.PaintPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>

        <!-- Выбор пушек -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <DockPanel Margin="0,-2,0,8">
                    <Button x:Name="ResetButton" DockPanel.Dock="Right" Style="{StaticResource SoftButton}"
                            Content="Сбросить" Height="26" Padding="11,0" Visibility="Hidden" Click="Reset_Click"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource CardIcon}" Text="&#xEA18;"/>
                        <TextBlock Style="{StaticResource CardTitle}" Text="ПУШКИ ВРАГОВ"/>
                    </StackPanel>
                </DockPanel>
                <UniformGrid x:Name="WeaponsGrid" Columns="6" Margin="-2,0,-2,0"/>
                <TextBlock x:Name="SelectionHint" Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource SubText}"/>
            </StackPanel>
        </Border>

        <!-- Подходящие краски -->
        <DockPanel DockPanel.Dock="Top" Margin="4,10,8,8">
            <Button x:Name="OnlyMineToggle" DockPanel.Dock="Right" Style="{StaticResource Chip}" Width="104" Height="26"
                    Click="OnlyMine_Click" ToolTip="Показывать только краски, отмеченные во вкладке «Мои краски»">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE73E;" FontSize="10"
                               Margin="0,1,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Только мои" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <TextBlock x:Name="ResultsTitle" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"
                       Foreground="{DynamicResource SubText}"/>
        </DockPanel>
        <ScrollViewer x:Name="ResultsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/>
            </ScrollViewer.Resources>
            <StackPanel x:Name="ResultsList"/>
        </ScrollViewer>
    </DockPanel>
</UserControl>
